# ====================
# 服务器部署配置模板（复制为 deploy/.env 后填写真实值）
# 真实 .env 不要提交到 git
# ====================

# ---------- 内部服务（docker 内网） ----------
MONGODB_HOST=host.docker.internal
MONGODB_PORT=27017
MONGODB_USERNAME=change_me
MONGODB_PASSWORD=change_me
MONGODB_AUTH_SOURCE=admin
MONGODB_DATABASE=rag_memory
MONGODB_MEMORY_COLLECTION=conversation_memories
MONGODB_USER_COLLECTION=users
MONGODB_IMPORT_TASK_COLLECTION=import_tasks
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

MILVUS_URL=http://milvus-standalone:19530
ITEM_NAME_COLLECTION=kb_item_names_aliyun
CHUNKS_COLLECTION=kb_chunks_aliyun

# MinIO：S3 操作走内网，图片 URL 使用对外地址
MINIO_ENDPOINT=milvus-minio:9000
MINIO_PUBLIC_ENDPOINT=203.195.206.242:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET_NAME=rag

# ---------- LLM（查询侧 DeepSeek / 视觉侧 DashScope） ----------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-
LLM_DEFAULT_MODEL=deepseek-flash
ITEM_MODEL=deepseek-flash
ANSWER_MODEL=deepseek-flash
VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_API_KEY=sk-
VL_MODEL=qwen3.7-flash
OPENAI_API_KEY=sk-
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_TEMPERATURE=0.1

# ---------- Embedding / Rerank（DashScope） ----------
EMBEDDING_PROVIDER=aliyun
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_REQUEST_TIMEOUT=60
EMBEDDING_MAX_RETRIES=2
DASHSCOPE_API_KEY=sk-
DASHSCOPE_NATIVE_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
DASHSCOPE_RERANK_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
DASHSCOPE_RERANK_MODEL=qwen3.7-text-rerank
RERANK_TIMEOUT=30
RERANK_MIN_RESULTS=3
RERANK_MAX_RESULTS=10
RERANK_ABSOLUTE_GAP=0.5
RERANK_RELATIVE_GAP=0.25

# ---------- MinerU（PDF 解析） ----------
MINERU_API_TOKEN=sk-
MINERU_BASE_URL=https://mineru.net/api/v4

# ---------- 认证 ----------
AUTH_SECRET_KEY=replace_with_random_32_chars
AUTH_COOKIE_NAME=rag_session
AUTH_TOKEN_EXPIRE_HOURS=24
AUTH_COOKIE_SECURE=False

# ---------- FastAPI ----------
API_CORS_ORIGINS=http://203.195.206.242
API_MAX_UPLOAD_MB=100
API_UPLOAD_DIR=.runtime/uploads

# ---------- 导入 / 图片摘要 ----------
IMAGE_SUMMARY_REQUESTS_PER_MINUTE=60
IMAGE_SUMMARY_CONCURRENCY=6

# ---------- 查询 ----------
QUERY_HISTORY_LIMIT=20
QUERY_EXTRACT_HISTORY_MESSAGES=8
QUERY_EXTRACT_HISTORY_CHARS=500
ANSWER_HISTORY_MESSAGES=6
ANSWER_HISTORY_CHARS=500
ITEM_NAME_TOP_K=5
ITEM_NAME_CONFIRM_THRESHOLD=0.80
ITEM_NAME_CANDIDATE_THRESHOLD=0.60
ITEM_NAME_SCORE_MARGIN=0.10
ITEM_NAME_DENSE_WEIGHT=0.7
ITEM_NAME_SPARSE_WEIGHT=0.3
QUERY_SEARCH_TOP_K=5
QUERY_SEARCH_DENSE_WEIGHT=0.8
QUERY_SEARCH_SPARSE_WEIGHT=0.2
WEB_SEARCH_MCP_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
WEB_SEARCH_MCP_TOOL=bailian_web_search
WEB_SEARCH_TOP_K=5
WEB_SEARCH_TIMEOUT=10
RRF_K=60
RRF_EMBEDDING_WEIGHT=1.0
RRF_HYDE_WEIGHT=0.7
RRF_MAX_RESULTS=10
