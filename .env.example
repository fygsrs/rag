# ====================
# MinerU API
# ====================

MINERU_API_TOKEN=sk-
MINERU_BASE_URL=https://mineru.net/api/v4


# ====================
# OpenAI / LLM API（DashScope compatible）
# ====================

# API 密钥（兼容 OpenAI 格式）
OPENAI_API_KEY=sk-

# API 基础地址（阿里云 DashScope）
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认 LLM 模型
LLM_DEFAULT_MODEL=qwen3.7-flash
# 视觉模型
VL_MODEL=qwen3.7-flash
# 商品主体识别模型
ITEM_MODEL=qwen3.7-flash
# 默认温度参数（0-1，越低越稳定）
LLM_DEFAULT_TEMPERATURE=0.1

# ====================
# Optional BGE-M3（仅 EMBEDDING_PROVIDER=bge 时使用）
# ====================
# BGE-M3 模型本地路径
BGE_M3_PATH=D:\ai_models\modelscope_cache\models\BAAI\bge-m3
# BGE-M3 模型名称
BGE_M3=BAAI/bge-m3
# 嵌入模型运行设备
BGE_DEVICE=cuda:0
# 是否使用半精度（True/False）
BGE_FP16=True
# ====================
# Embedding（默认使用阿里云）
# ====================
# 向量提供方：默认 aliyun；需要本地模型时改为 bge
EMBEDDING_PROVIDER=aliyun
# 嵌入向量维度（BGE-M3 和阿里云模型统一使用 1024）
EMBEDDING_DIM=1024
# 单批向量化文本数量
EMBEDDING_BATCH_SIZE=8
# DashScope 向量模型 API Key（未设置时会复用 OPENAI_API_KEY）
DASHSCOPE_API_KEY=sk-
# DashScope 原生向量接口（dense&sparse 需要使用原生接口）
DASHSCOPE_NATIVE_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
# 向量接口超时秒数
EMBEDDING_REQUEST_TIMEOUT=60
# DashScope 向量模型
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding-flash

# ====================
# Vector Database (Milvus)
# ====================
MILVUS_URL=http://192.168.150.101:19530
ITEM_NAME_COLLECTION=kb_item_names_aliyun
CHUNKS_COLLECTION=kb_chunks_aliyun

# ====================
# Object Storage (MinIO)
# ====================

MINIO_ENDPOINT=192.168.150.101:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=rag

# ====================
# Conversation Memory (MongoDB)
# ====================

MONGODB_HOST=192.168.150.101
MONGODB_PORT=27017
MONGODB_USERNAME=rag_admin
MONGODB_PASSWORD=change_me
MONGODB_AUTH_SOURCE=admin
MONGODB_DATABASE=rag_memory
MONGODB_MEMORY_COLLECTION=conversation_memories
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# ====================
# Query / Item Name Confirmation
# ====================

# 读取的最近会话消息数
QUERY_HISTORY_LIMIT=20
# 商品名称混合检索返回数量
ITEM_NAME_TOP_K=5
# 自动确认阈值（最高分需同时满足分差阈值）
ITEM_NAME_CONFIRM_THRESHOLD=0.85
# 候选商品最低分数
ITEM_NAME_CANDIDATE_THRESHOLD=0.60
# 第一名领先第二名的最低分差
ITEM_NAME_SCORE_MARGIN=0.15
# 稠密向量与稀疏向量的融合权重
ITEM_NAME_DENSE_WEIGHT=0.7
ITEM_NAME_SPARSE_WEIGHT=0.3
# 正文与 HyDE 混合检索统一返回 Top 5
QUERY_SEARCH_TOP_K=5
# 正文与 HyDE 混合检索的稠密/稀疏权重
QUERY_SEARCH_DENSE_WEIGHT=0.8
QUERY_SEARCH_SPARSE_WEIGHT=0.2
